# Tuya OpenAPI credentials — https://iot.tuya.com
TUYA_ACCESS_KEY=your_client_id_here
TUYA_SECRET_KEY=your_client_secret_here
TUYA_DEVICE_ID=your_device_id_here

# Region base URL:
#   EU  → https://openapi.tuyaeu.com
#   US  → https://openapi.tuyaus.com
#   CN  → https://openapi.tuyacn.com
#   IN  → https://openapi.tuyain.com
TUYA_BASE_URL=https://openapi.tuyaeu.com

# Internal API key — protect all endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=your_api_key_here

# GitHub webhook secret — used to verify payloads from GitHub
# Set the same value in GitHub repo → Settings → Webhooks → Secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
